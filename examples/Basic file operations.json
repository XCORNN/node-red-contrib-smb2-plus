  {
    "id": "a1b2c3d4e5f60032",
    "type": "function",
    "z": "a1b2c3d4e5f60001",
    "name": "build line",
    "func": "const now = new Date();\nconst day = now.toISOString().slice(0, 10);\nmsg.folder = \"Reports\\\\logs\";\nmsg.filename = msg.folder;               // used by \"ensure directory\"\nmsg.logfile = msg.folder + \"\\\\log_\" + day + \".csv\";\nmsg.line = now.toISOString() + \";\" + Math.round(Math.random() * 100) + \"\\n\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 310,
    "y": 280,
    "wires": [
